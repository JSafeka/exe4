* {
    font-family: "Segoe UI", "Arial";
}

QMainWindow,
QWidget#centralWidget,
QWidget {
    background: #111827;
    color: #f3f4f6;
}

QLabel {
    background: transparent;
}

QLabel#pageTitle {
    color: #f9fafb;
    font-size: 28px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #9ca3af;
    font-size: 13px;
    margin-bottom: 2px;
}

QWidget#graphCard,
QWidget#statsCard,
QWidget#controlCard {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 14px;
}

QWidget#statsCard {
    min-width: 210px;
    max-width: 250px;
}

QLabel#statsTitle {
    color: #f9fafb;
    font-size: 15px;
    font-weight: 700;
    padding-bottom: 8px;
    border-bottom: 1px solid #374151;
}

QLabel#averageValue {
    background: #111827;
    color: #dbeafe;
    border: 1px solid #374151;
    border-radius: 10px;
    min-height: 48px;
    padding: 0 12px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton {
    min-height: 38px;
    min-width: 118px;
    padding: 0 16px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#primaryButton {
    background: #3b82f6;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QPushButton#primaryButton:hover {
    background: #2563eb;
}

QPushButton#secondaryButton {
    background: #273244;
    color: #e5e7eb;
    border: 1px solid #4b5563;
}

QPushButton#secondaryButton:hover {
    background: #374151;
    border-color: #6b7280;
}

QPushButton:pressed {
    padding-top: 2px;
}

NavigationToolbar2QT,
QToolBar {
    background: #1f2937;
    border: none;
    spacing: 4px;
}

NavigationToolbar2QT QToolButton,
QToolBar QToolButton {
    background: #273244;
    color: #d1d5db;
    border: 1px solid #374151;
    border-radius: 6px;
    width: 28px;
    height: 28px;
    margin: 2px;
}

NavigationToolbar2QT QToolButton:hover,
QToolBar QToolButton:hover {
    background: #374151;
}

QWidget#aboutWindow {
    background: #111827;
}

QLabel#aboutImage {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 12px;
    max-height: 250px;
}

QLabel#aboutName {
    color: #f9fafb;
    font-size: 20px;
    font-weight: 700;
    margin-top: 6px;
}

QLabel#aboutEmail,
QLabel#aboutLink {
    color: #d1d5db;
    font-size: 13px;
}

QLabel#aboutLink a {
    color: #60a5fa;
    text-decoration: none;
}
